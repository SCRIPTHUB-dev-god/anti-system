    Staff = {
        Usernames = {
            "Roblox",
            "Builderman",
        },
        GroupID  = 0,
        MinRank  = 100,
        Keywords = {
            "mod", "admin", "dev", "staff", "moderator",
            "administrator", "owner", "helper", "support",
            "officer", "manager", "supervisor",
        },
    },
    Hop = {
        CandidatePool = 10,
        FetchPages    = 2,
        RetryDelay    = 8,
    },
}

